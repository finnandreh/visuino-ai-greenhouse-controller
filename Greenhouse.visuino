                  "OnData": "uint16_t y,m,d,h,n,s,ms; AValue.DecodeDateTime(y,m,d,h,n,s,ms); if(m>12 || d>31 || h>23 || n>59 || s>59) ghClock.invalidate(); else ghClock.sample((uint32_t)millis(),y,(uint8_t)m,(uint8_t)d,(uint8_t)h,(uint8_t)n,(uint8_t)s);",

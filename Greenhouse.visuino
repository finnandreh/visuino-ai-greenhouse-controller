            "+": "TArduinoCustomCode",
            "Members": "  struct GreenhouseDisplay { int16_t temperatureTenths = 0; uint16_t humidity = 0; uint32_t soil1 = 0, soil2 = 0, outside = 0, inside = 0, civil = 0; bool timeout = false, empty = true, invalidClimate = true, hot = false; bool clockFault = true, automatic = true, valve1 = false, valve2 = false; bool pump = false, fan = false, heat = false, light = false; bool rest = false, inhibit = true, ready = false;  static unsigned percent(uint32_t adc) { if (adc > 1023) adc = 1023; return unsigned((adc * 100UL + 511UL) / 1023UL); } static void pad(char *out, const char *text) { uint8_t i = 0; while (i < 20 && text[i]) { out[i] = text[i]; ++i; } while (i < 20) out[i++] = ' '; out[20] = 0; } const char *status() const { if (timeout) return \"TIMEOUT\"; if (empty) return \"EMPTY\"; if (invalidClimate) return \"TEMP INVALID\"; if (hot) return \"OVER TEMP\"; if (clockFault) return \"CLOCK INVALID\"; if (!ready) return \"STARTING\"; if (rest) return \"REST\"; if (!automatic && inhibit) return \"RELEASE BUTTONS\"; if (valve1) return \"WATER ZONE 1\"; if (valve2) return \"WATER ZONE 2\"; return \"READY\"; } void render(uint32_t now, char rows[4][21]) const { char text[48]; snprintf(text,sizeof(text),\"%s %s\",automatic ? \"A\" : \"M\",status()); pad(rows[0],text); if (invalidClimate) { snprintf(text,sizeof(text),\"T:--.-C H:---%% F:%d\",int(fan)); pad(rows[1],text); } else { const unsigned mag = temperatureTenths < 0 ? unsigned(-int32_t(temperatureTenths)) : unsigned(temperatureTenths); snprintf(text,sizeof(text),\"T:%s%u.%uC H:%u%%\",temperatureTenths < 0 ? \"-\" : \"\",mag/10,mag%10,unsigned(humidity)); pad(rows[1],text); } if ((now / 4000UL) % 2 == 0) snprintf(text,sizeof(text),\"S1:%3u%% S2:%3u%%\",percent(soil1),percent(soil2)); else snprintf(text,sizeof(text),\"P%d V%d%d F%d H%d R%d\",int(pump),int(valve1),int(valve2),int(fan),int(heat),int(rest)); pad(rows[2],text); if (clockFault) snprintf(text,sizeof(text),\"I%u O%u L%d --:--\",percent(inside),percent(outside),int(light)); else snprintf(text,sizeof(text),\"I%u O%u L%d %02u:%02u\",percent(inside),percent(outside),int(light),unsigned(civil/3600UL),unsigned((civil/60UL)%60UL)); pad(rows[3],text); } }; GreenhouseDisplay view; uint32_t lastRender=0;",
            "ClockInputPin": {
              "SourcePins": [
                {
                  "ID": "__OpenWireRootUnit__.SoilClock.OutputPin"
                }
              ]
            },
            "OnStart": "lastRender=(uint32_t)millis(); char rows[4][21]; view.render((uint32_t)millis(),rows); Line1.Send(rows[0]); Line2.Send(rows[1]); Line3.Send(rows[2]); Line4.Send(rows[3]);",
            "OnExecute": "const uint32_t now=(uint32_t)millis(); if(uint32_t(now-lastRender)<500UL) return; lastRender=now; char rows[4][21]; view.render((uint32_t)millis(),rows); Line1.Send(rows[0]); Line2.Send(rows[1]); Line3.Send(rows[2]); Line4.Send(rows[3]);"
          },

            "OnExecute": "const uint32_t now = (uint32_t)millis();\r\n ghStep(now);\r\n   if (ghSentPump && (!ghPump || ghSentValve1 != ghValve1 || ghSentValve2 != ghValve2)) {\r\n   Pump.Send(false);\r\n   ghSentPump = false;\r\n}\r\n Valve1.Send(ghValve1);\r\n Valve2.Send(ghValve2);\r\n Pump.Send(ghPump);\r\n ghSentValve1 = ghValve1;\r\n ghSentValve2 = ghValve2;\r\n ghSentPump = ghPump;\r\n Timeout.Send(ghTimeout);\r\n Rest.Send(ghRest);\r\n Inhibit.Send(ghManualInhibit);\r\n   Serial.print(F(\"GH|\"));\r\n Serial.print(now);\r\n Serial.print('|');\r\n Serial.print(ghAuto);\r\n Serial.print('|');\r\n Serial.print(ghSourceOK);\r\n Serial.print('|');\r\n Serial.print(ghButton1);\r\n Serial.print('|');\r\n Serial.print(ghButton2);\r\n Serial.print('|');\r\n Serial.print(ghDry1);\r\n Serial.print('|');\r\n Serial.print(ghDry2);\r\n Serial.print('|');\r\n Serial.print(ghZone);\r\n Serial.print('|');\r\n Serial.print(ghNextZone);\r\n Serial.print('|');\r\n Serial.print(ghValve1);\r\n Serial.print('|');\r\n Serial.print(ghValve2);\r\n Serial.print('|');\r\n Serial.print(ghPump);\r\n Serial.print('|');\r\n Serial.print(ghTimeout);\r\n Serial.print('|');\r\n Serial.print(ghRest);\r\n Serial.print('|');\r\n Serial.println(ghManualInhibit);\r\n",

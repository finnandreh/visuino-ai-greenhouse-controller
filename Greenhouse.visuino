        {
          "Name": "IrrigationController",
          "Width": 160,
          "Instance": {
            "Members": "bool ghReady = false, ghAuto = true, ghSourceOK = false;\r\n bool ghButton1 = false, ghButton2 = false, ghDry1 = false, ghDry2 = false;\r\n bool ghValve1 = false, ghValve2 = false, ghPump = false;\r\n bool ghTimeout = false, ghRest = false, ghManualInhibit = true;\r\n bool ghInitialized = false, ghPreviousAuto = true, ghPreviousSource = false;\r\n bool ghResetHolding = false;\r\n uint8_t ghZone = 0, ghNextZone = 1;\r\n uint32_t ghRunAt = 0, ghRestAt = 0, ghResetAt = 0;\r\n void ghBeginRest(uint32_t now) {\r\n   ghRest = true;\r\n   ghRestAt = now;\r\n}\r\n void ghStep(uint32_t now) {\r\n   ghValve1 = ghValve2 = ghPump = false;\r\n   if (!ghReady) {\r\n     ghZone = 0;\r\n     ghManualInhibit = true;\r\n     ghResetHolding = false;\r\n     ghInitialized = false;\r\n     ghRest = false;\r\n     return;\r\n  }\r\n   if (!ghInitialized) {\r\n     ghPreviousAuto = ghAuto;\r\n     ghPreviousSource = ghSourceOK;\r\n     ghInitialized = true;\r\n     if (!ghSourceOK) ghBeginRest(now);\r\n  }\r\n   const bool modeChanged = ghAuto != ghPreviousAuto;\r\n   const bool sourceLost = ghPreviousSource && !ghSourceOK;\r\n   ghPreviousAuto = ghAuto;\r\n   ghPreviousSource = ghSourceOK;\r\n     const bool expired = ghZone != 0 && uint32_t(now - ghRunAt) >= 10000UL;\r\n   if (expired) ghTimeout = true;\r\n   const bool demand = ghZone == 1 ? (ghAuto ? ghDry1 : (!ghManualInhibit && ghButton1)) : (ghAuto ?\r\n       ghDry2 : (!ghManualInhibit && ghButton2));\r\n   if (ghZone && (ghTimeout || !ghSourceOK || modeChanged || !demand)) {\r\n     ghZone = 0;\r\n     ghBeginRest(now);\r\n  }\r\n   if (modeChanged || sourceLost) {\r\n     ghManualInhibit = true;\r\n     ghBeginRest(now);\r\n  }\r\n   if (ghRest && uint32_t(now - ghRestAt) >= 15000UL) ghRest = false;\r\n   const bool resetAllowed = ghTimeout && !ghAuto && ghSourceOK && ghButton1 && ghButton2 && ghZone\r\n       == 0;\r\n   if (resetAllowed) {\r\n     if (!ghResetHolding) {\r\n       ghResetHolding = true;\r\n       ghResetAt = now;\r\n    }\r\n     if (uint32_t(now - ghResetAt) >= 2000UL) {\r\n       ghTimeout = false;\r\n       ghResetHolding = false;\r\n       ghManualInhibit = true;\r\n       ghBeginRest(now);\r\n    }\r\n  }\r\n   else ghResetHolding = false;\r\n   if (ghSourceOK && !ghButton1 && !ghButton2) ghManualInhibit = false;\r\n   const bool eligible1 = ghAuto ? ghDry1 : (!ghManualInhibit && ghButton1);\r\n   const bool eligible2 = ghAuto ? ghDry2 : (!ghManualInhibit && ghButton2);\r\n   if (!ghZone && !ghTimeout && !ghRest && ghSourceOK) {\r\n     if (eligible1 || eligible2) {\r\n       ghZone = (ghNextZone == 1) ? (eligible1 ? 1 : 2) : (eligible2 ? 2 : 1);\r\n       ghNextZone = ghZone == 1 ? 2 : 1;\r\n       ghRunAt = now;\r\n    }\r\n  }\r\n   ghValve1 = ghZone == 1 && ghSourceOK && !ghTimeout;\r\n   ghValve2 = ghZone == 2 && ghSourceOK && !ghTimeout;\r\n   ghPump = ghValve1 || ghValve2;\r\n}\r\n   bool ghSentPump = false, ghSentValve1 = false, ghSentValve2 = false;\r\n",
            "Inputs": {
              "*": [
                {
                  "Name": "Ready",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.InputsReady.OutputPin"
                    }
                  },
                  "OnData": "ghReady = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "AutoMode",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.ModeSample.OutputPin"
                    }
                  },
                  "OnData": "ghAuto = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "SourceOK",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.EmptySample.OutputPin"
                    }
                  },
                  "OnData": "ghSourceOK = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "Button1",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.Manual1Held.OutputPin"
                    }
                  },
                  "OnData": "ghButton1 = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "Button2",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.Manual2Held.OutputPin"
                    }
                  },
                  "OnData": "ghButton2 = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "Dry1",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.SoilRequest1.OutputPin"
                    }
                  },
                  "OnData": "ghDry1 = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                },
                {
                  "Name": "Dry2",
                  "InputPin": {
                    "SourcePin": {
                      "ID": "__OpenWireRootUnit__.SoilRequest2.OutputPin"
                    }
                  },
                  "OnData": "ghDry2 = AValue;",
                  "+": "TArduinoCustomCodeInputDigitalElement"
                }
              ]
            },
            "ClockInputPin": {
              "SourcePins": [
                {
                  "ID": "__OpenWireRootUnit__.ScanReadyGate.OutputPin"
                }
              ]
            },
            "OnStart": "Pump.Send(false);\r\n Valve1.Send(false);\r\n Valve2.Send(false);\r\n Timeout.Send(false);\r\n Rest.Send(false);\r\n Inhibit.Send(true);\r\n ghSentPump = ghSentValve1 = ghSentValve2 = false;\r\n",
            "Outputs": {
              "*": [
                {
                  "Name": "Pump",
                  "OutputPin": {
                    "SinkPins": [
                      {
                        "ID": "__OpenWireRootUnit__.Arduino.Digital._Item2.DigitalInputPin",
                        "Name": "__OpenWireRootUnit__.Arduino.Digital.Digital[ 2 ].DigitalInputPin"
                      },
                      {
                        "ID": "__OpenWireRootUnit__.StatusDisplay.Inputs._Item15.InputPin",
                        "Name": "__OpenWireRootUnit__.StatusDisplay.Inputs.pump.InputPin"
                      }
                    ]
                  },
                  "+": "TArduinoCustomCodeOutputDigitalElement"
                },
                {
                  "Name": "Valve1",
                  "OutputPin": {
                    "SinkPins": [
                      {
                        "ID": "__OpenWireRootUnit__.Arduino.Digital._Item8.DigitalInputPin",
                        "Name": "__OpenWireRootUnit__.Arduino.Digital.Digital[ 8 ].DigitalInputPin"
                      },
